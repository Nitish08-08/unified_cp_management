# Unified CP Management - Environment Configuration Template
# Duplicate this file to .env and insert your real production secrets.
# NEVER commit your actual .env file with secrets to Git.

# TiDB Cloud Serverless / MySQL Database Connection
DB_HOST=gateway01.ap-northeast-1.prod.aws.tidbcloud.com
DB_PORT=4000
DB_NAME=competitive_cp
DB_USER=your_db_username
DB_PASS=your_db_password
MYSQL_ATTR_SSL_CA=certs/isrgrootx1.pem

# Mentor Access Security (Passkey for authorized mentor registrations)
MENTOR_SECRET_KEY=MENTOR2026

# AI Competitive Programming Coach Configuration
# Supports Google Gemini API, OpenAI API, or any OpenAI-compatible API endpoint.
# If left empty, the intelligent built-in CP diagnostic engine will operate without external API keys.
AI_API_KEY=
AI_MODEL=gemini-1.5-flash
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# For OpenAI:
# AI_API_KEY=your_openai_api_key
# AI_MODEL=gpt-4o-mini
# AI_BASE_URL=https://api.openai.com/v1
